{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": ["src"]
    },
    "logs": {
        "text": "build/infection/infection.log",
        "summary": "build/infection/summary.log"
    },
    "tmpDir": "build/infection",
    "phpUnit": {
        "configDir": "."
    },
    "testFrameworkOptions": "--testsuite=unit",
    "minMsi": 85,
    "mutators": {
        "@default": true,
        // Il codice 0 è osservabile solo costruendo l'eccezione a mano: run() la converte in exit code.
        "global-ignoreSourceCodeByRegex": [".*failed to register the handlers.*"]
    }
}
