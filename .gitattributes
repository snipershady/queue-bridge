* text=auto eol=lf

# Export-ignore: dev-only files are left out of `composer archive` / GitHub zip downloads
/.github/                 export-ignore
/.gitattributes           export-ignore
/.gitignore               export-ignore
/.php-cs-fixer.dist.php   export-ignore
/docker-compose.yml       export-ignore
# Runnable examples, sample payloads (examples/data) and deployment files (examples/deploy): repository only
/examples/                export-ignore
/infection.json5          export-ignore
/phpstan.neon             export-ignore
/phpunit.xml.dist         export-ignore
/rector.php               export-ignore
/tests/                   export-ignore
/tools/                   export-ignore

# Example and deployment files keep LF line endings on every platform
*.service text eol=lf
*.conf    text eol=lf
*.json    text eol=lf
*.txt     text eol=lf

# Binary
*.gif binary
*.png binary
*.jpg binary

composer.lock -diff
