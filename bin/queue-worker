#!/usr/bin/env php
<?php

declare(strict_types=1);

use snipershady\Queue\Cli\Application;
use snipershady\Queue\Cli\Output;

// Progetto clonato (vendor/ accanto a bin/) oppure libreria installata come dipendenza (vendor/bin/).
foreach ([__DIR__.'/../vendor/autoload.php', __DIR__.'/../../../autoload.php'] as $autoload) {
    if (is_file($autoload)) {
        require $autoload;

        break;
    }
}

$environment = getenv();

exit((new Application(new Output(STDOUT, STDERR), environment: $environment))->run(array_values(array_slice($argv, 1))));
